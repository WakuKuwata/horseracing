# 169 private observer profile template. Copy with `init-profile`; do not shell-source this file.
# Dedicated login and privileges are not provisioned by creating this file.
# Confirm the intended cluster/database before editing this separately from deploy/.env.
HORSERACING_OBSERVER_PROFILE_VERSION=169-v1
HORSERACING_ENDPOINT_CONFIRMED=false
HORSERACING_EXPECTED_DATABASE=horseracing
HORSERACING_EXPECTED_ROLE=hr_manual_observer
DATABASE_URL=postgresql+psycopg://hr_manual_observer:REPLACE_WITH_PRIVATE_SECRET@127.0.0.1:15432/horseracing
# Carry over the operator-approved source interval; never lower it to make a probe pass.
HORSERACING_NETKEIBA_MIN_INTERVAL_S=REPLACE_WITH_APPROVED_INTERVAL
# Default shared repository robots directory if this key is absent. No refresh is done.
